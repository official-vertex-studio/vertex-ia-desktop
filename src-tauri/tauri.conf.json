{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vertex AI",
  "version": "2.9.1",
  "identifier": "fr.vertexstudio.vertexai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vertex AI",
        "width": 1480,
        "height": 940,
        "minWidth": 1050,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#090c12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:11435 http://127.0.0.1:11435 https://ollama.com https://registry.ollama.ai"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local AI desktop workspace",
    "longDescription": "Chat with local Ollama models, manage projects and work with AI coding agents.",
    "publisher": "Vertex Studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/ollama-windows-amd64.zip"
    ],
    "windows": {
      "bundleVCRuntime": true,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  }
}
